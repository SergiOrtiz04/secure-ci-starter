# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Only PORT is used by this starter; the rest shows the convention for
# naming and documenting secrets so they never end up hard-coded.

# HTTP port the API listens on
PORT=3000

# Example of how a real secret would be declared (NOT used by this demo):
# SESSION_SECRET=replace-with-32-random-bytes-base64
# DATABASE_URL=postgres://user:password@localhost:5432/app
